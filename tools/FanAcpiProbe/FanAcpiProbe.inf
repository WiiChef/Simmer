[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
DriverVer=11/02/2026,0.1.0.0
CatalogFile=FanAcpiProbe.cat
PnpLockdown=1

; Primitive package: registers a service, never matches all ACPI0013 devices.
[DefaultInstall.NTarm64]
CopyFiles=DriverCopy

[DefaultInstall.NTarm64.Services]
AddService=FanAcpiProbe,,DriverService

[DefaultInstall.NTarm64.Wdf]
KmdfService=FanAcpiProbe,WdfSection

[WdfSection]
KmdfLibraryVersion=1.33

[DriverService]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\FanAcpiProbe.sys

[DestinationDirs]
DriverCopy=13

[DriverCopy]
FanAcpiProbe.sys

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
FanAcpiProbe.sys=1

[Strings]
Provider="PowerCap local diagnostics"
ServiceName="PowerCap ECGE diagnostic filter"
DiskName="PowerCap ECGE diagnostic driver"
